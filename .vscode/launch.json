{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug On Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ForMyBaby",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug On Mac",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/ForMyBaby.app/Contents/MacOS/ForMyBaby",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "mac-build"
        }
    ]
}