{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cd ${workspaceFolder}/build && cmake .. && make -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "mac-build",
            "type": "shell",
            "command": "cd ${workspaceFolder}/build && /opt/homebrew/bin/cmake .. && make -j$(sysctl -n hw.ncpu)",
            "group": {
                "kind": "build"
            },
            "problemMatcher": "$gcc"
        }
    ]
}